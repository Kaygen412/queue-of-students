h1 {
    font-weight: 500;
    letter-spacing: 5px;
    color: deeppink;
    text-align: center;
}
.circle {
    display: inline-block;
    width: 120px;
    height: 120px;
    line-height: 120px;
    margin: 10px;
    border-radius: 50%;
    font-size: 12px;
    text-transform: uppercase;
    text-align: center;
}

.color1 { background-color: #f62f5e; }
.color2 { background-color: #f1ad3d; }
.color3 { background-color: #6ebdca; }
.color4 { background-color: #eefc91; }
.color5 { background-color: #F7ECEB; }

.details {
    font-size: 16px;
    color: silver;
}
#colors div {
    text-align: center;
}
h2{
    font-family: 'Oswald', sans-serif;
    font-weight: 600;
    size:36px;
}
h3{
    font-family: 'Oswald', sans-serif;
    font-weight: 500;
    size:24px;
}
h4{
    font-family: 'Oswald', sans-serif;
    font-weight: 400;
    size:16px;
}
.bodytext {
    font-family: 'Open Sans', sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 24px;
    margin: 0 0 1em 0;
}

.asidetext {
    font-family: 'Open Sans', sans-serif;
    font-weight: 300;
    font-size: 12px;
    line-height: 15px;
    margin: 0 0 1em 0;
}
